<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ergo_background_light"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_ergocare_logo"
            app:tint="@color/ergo_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Penilaian Risiko"
            android:textColor="@color/ergo_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvQuestionProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PERTANYAAN 1 DARI 5"
                android:textColor="@color/ergo_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuestionCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Layar &amp; Meja"
                android:textColor="@color/ergo_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="5"
            android:progress="1"
            android:progressDrawable="@drawable/bg_security_pill"
            android:progressTint="@color/ergo_primary" />
    </LinearLayout>

    <!-- Question Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/ergo_card_bg"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bagaimana posisi layar terhadap mata Anda saat bekerja?"
                android:textColor="@color/ergo_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <RadioButton
                    android:id="@+id/rbOpt1"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_security_pill"
                    android:backgroundTint="@color/ergo_background_light"
                    android:buttonTint="@color/ergo_primary"
                    android:paddingStart="12dp"
                    android:text="Sejajar dengan mata"
                    android:textColor="@color/ergo_text_primary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbOpt2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_security_pill"
                    android:backgroundTint="@color/ergo_card_bg"
                    android:buttonTint="@color/ergo_primary"
                    android:paddingStart="12dp"
                    android:text="Terlalu rendah (leher menunduk)"
                    android:textColor="@color/ergo_text_secondary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbOpt3"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_security_pill"
                    android:backgroundTint="@color/ergo_card_bg"
                    android:buttonTint="@color/ergo_primary"
                    android:paddingStart="12dp"
                    android:text="Terlalu tinggi (leher mendongak)"
                    android:textColor="@color/ergo_text_secondary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbOpt4"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_security_pill"
                    android:backgroundTint="@color/ergo_card_bg"
                    android:buttonTint="@color/ergo_primary"
                    android:paddingStart="12dp"
                    android:text="Tidak tentu / berubah-ubah"
                    android:textColor="@color/ergo_text_secondary"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Current Score Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKOR RISIKO SEMENTARA"
            android:textColor="@color/ergo_text_secondary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rendah"
                android:textColor="@color/ergo_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="6dp"
                android:text="2 dari 10 poin"
                android:textColor="@color/ergo_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackAssessment"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="0.4"
            android:backgroundTint="@color/ergo_secondary"
            android:text="Kembali"
            android:textColor="@color/ergo_primary_dark"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextAssessment"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="0.6"
            android:backgroundTint="@color/ergo_primary"
            android:text="Lanjut"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="16dp" />
    </LinearLayout>

</LinearLayout>
